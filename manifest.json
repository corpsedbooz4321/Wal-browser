{
  "manifest_version": 3,
  "version": "0.1.0",
  "name": "pywal-injector - for browsers",
  "description": "An pywal-injector that lets you change the theme of your browsers from colors generated by your wallpaper.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "pywal-injector - for browsers",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/wal_browser/content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "theme.css",
        "colors.json"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
