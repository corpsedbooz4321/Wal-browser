{
  "manifest_version": 3,
  "version": "0.1.0",
  "name": "pywal-injector - for browsers",
  "description": "An pywal-injector that lets you change the theme of your browsers from colors generated by your wallpaper. It's not limited to the ui, tabs, address bar also the colors, of your desktop wallpaper.",
  "icons": {
    "16": "icons16/icon-16.png",
    "48": "icons48/icon-48.png",
    "128": "icons128/icon-128.png"
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "pywal-injector - for browsers",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons16/icon-16.png",
      "48": "icons48/icon-48.png",
      "128": "icons128/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "theme.css",
        "colors.json"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
